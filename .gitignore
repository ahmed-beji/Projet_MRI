*.raw

# Model checkpoints and outputs
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.weights
model_checkpoints/
checkpoints/
outputs/
results/
logs/

# Temporary and cache files
*.tmp
*.temp
*.log
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.cache/
.mypy_cache/
.pytest_cache/

# OS/editor junk
.DS_Store
Thumbs.db
